# --- API Keys ---
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- Meshtastic Connection ---
MESHTASTIC_CONNECTION_TYPE=serial
MESHTASTIC_DEVICE_SPECIFIER=
# For TCP: MESHTASTIC_DEVICE_SPECIFIER=10.10.100.209

# --- Feature Switches ---
AI_ENABLED=true
BOT_COMMANDS_ENABLED=true

# --- AI Settings ---
DEFAULT_AI_SERVICE=openai

# --- Matrix Bridge (optional) ---
# Set MATRIX_ENABLED=true to bridge mesh messages to Matrix rooms
MATRIX_ENABLED=false
MATRIX_HOMESERVER=https://matrix.org
MATRIX_USERNAME=@your-bot:matrix.org
MATRIX_PASSWORD=your-bot-password
# Comma-separated list of Matrix user IDs to auto-invite to bridge rooms
MATRIX_INVITE_USERS=@your-account:matrix.org
# Display name for Matrix->Mesh messages (empty = use Matrix profile name)
MATRIX_DISPLAY_NAME=

# --- Matrix Error Reporter (optional) ---
# Sends critical errors/crashes to a dedicated Matrix room.
# Can be the same bot as above or a different one.
# ERROR_MATRIX_ROOM_ID should be the internal room ID: !xxxx:server
ERROR_MATRIX_HOMESERVER=https://matrix.org
ERROR_MATRIX_USERNAME=@your-bot:matrix.org
ERROR_MATRIX_PASSWORD=your-bot-password
ERROR_MATRIX_ROOM_ID=

# --- Web UI ---
# Password-protected dashboard accessible on LAN.
# Server will NOT start if WEB_UI_PASSWORD is empty.
WEB_UI_USERNAME=admin
WEB_UI_PASSWORD=
WEB_UI_PORT=8080
# Flask session secret - set a long random string in production
WEB_UI_SECRET_KEY=
